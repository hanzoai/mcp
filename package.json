{
  "name": "@hanzo/mcp",
  "version": "2.4.5",
  "packageManager": "pnpm@11.17.0",
  "description": "Hanzo MCP Server - Unified tool surface with AI, cloud control, vector search, and multi-framework UI",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "hanzo-mcp": "./dist/cli.js",
    "mcp": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "scripts/smoke-mcp.mjs",
    "server.js",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm build:lib && pnpm build:cli",
    "build:lib": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.js --external:@modelcontextprotocol/sdk --external:glob --external:commander --external:zod --external:zod-to-json-schema --external:mime-types --external:@lancedb/lancedb --external:@xenova/transformers --external:jsautogui --external:playwright --external:playwright-core --external:ws --external:path --external:fs --external:fs/promises --external:os --external:url",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/cli.js --external:@modelcontextprotocol/sdk --external:glob --external:commander --external:zod --external:zod-to-json-schema --external:mime-types --external:@lancedb/lancedb --external:@xenova/transformers --external:jsautogui --external:playwright --external:playwright-core --external:ws --external:path --external:fs --external:fs/promises --external:os --external:url && chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "smoke": "node scripts/smoke-mcp.mjs",
    "test": "jest",
    "lint": "echo 'No linter configured'",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "tools",
    "development"
  ],
  "author": "Hanzo AI",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/mime-types": "^3.0.1",
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "mime-types": "^3.0.2",
    "minimatch": "^10.2.4",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  },
  "optionalDependencies": {
    "@lancedb/lancedb": "^0.27.1",
    "@xenova/transformers": "^2.17.2",
    "jsautogui": "^2.1.3",
    "playwright": "^1.58.2",
    "playwright-core": "^1.58.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/glob": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/mcp.git"
  },
  "homepage": "https://hanzo.ai",
  "bugs": {
    "url": "https://github.com/hanzoai/mcp/issues"
  }
}
